VITE_API_MODE=mock          # mock | live
VITE_VOICE=off              # on | off
PORT=8787
GEMINI_API_KEY=
GEMINI_API_KEYS=            # optional: several keys separated by commas; a rate-limited key is rested and the next one is used
GEMINI_MODEL=gemini-3.8-flash   # use the newest Flash model listed in Google AI Studio
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DATABASE_URL=               # optional, Tiger Data / Postgres
ADMIN_TOKEN=change-me       # protects POST /api/scrape
